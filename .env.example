# 复制为.env.local。真实凭据不提交。运行脚本只读取允许的变量。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# MYSQL_USERNAME=
# MYSQL_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
MILVUS_URI=http://127.0.0.1:19530
CHAT_MODEL=qwen-plus
# DASHSCOPE_API_KEY=
# AMAP_MAPS_API_KEY=
# 以下三个独立32字节Base64密钥由scripts/setup_local.py生成。
# OTP_HMAC_KEY=
# OTP_DELIVERY_KEY=
# DEVICE_SIGNING_KEY=
# 注册、邮箱登录和找回密码需要真实SMTP。
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
SMTP_STARTTLS=true
COOKIE_SECURE=false
